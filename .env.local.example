YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard logins are personal accounts (own password + authenticator app),
# stored in Supabase — run supabase/migrations/004_staff_accounts.sql first.
# Signs login sessions: 32+ random characters. Changing it logs everyone out.
DASHBOARD_SESSION_SECRET=
# Only used once, at /dashboard/setup, to create the very first manager account.
MANAGER_DASHBOARD_PASSWORD=

# The live website address (used in SEO tags). Defaults to https://nambitacafe.co.za
NEXT_PUBLIC_SITE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Nambita Cafe <orders@yourdomain.com>
